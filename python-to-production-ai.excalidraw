      "boundElements": [],
      "updated": 1787939481387,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Most AI engineering jobs never train a model from scratch.",
      "textAlign": "left",
      "verticalAlign": "top",
