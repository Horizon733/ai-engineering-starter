      "link": null,
      "locked": false,
      "fontSize": 19,
      "fontFamily": 5,
      "text": "\"You summarize pages for\nsomeone in a hurry.\n\nExactly three bullets,\ntwenty words each,\nno introduction.\n\nIf the page is mostly ads,\nsay so instead.\"",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"You summarize pages for\nsomeone in a hurry.\n\nExactly three bullets,\ntwenty words each,\nno introduction.\n\nIf the page is mostly ads,\nsay so instead.\"",
      "lineHeight": 1.25,
      "autoResize": true
    },
