      "seed": 599713487,
      "version": 1,
      "versionNonce": 860546231,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787939481387,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Two questions that mean the same\nthing sit close together — even\nwith no words in common.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two questions that mean the same\nthing sit close together — even\nwith no words in common.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "0351a7901b5cd77e",
      "type": "text",
      "x": 3600,
      "y": 4435,
      "width": 358.40000000000003,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "4078ad8b62dcd617",
      "index": "a0445",
      "roundness": null,
      "seed": 1439909744,
      "version": 1,
      "versionNonce": 1865995774,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787939481387,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "So search stops being about\nmatching words, and starts being\nabout matching meaning.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So search stops being about\nmatching words, and starts being\nabout matching meaning.",
      "lineHeight": 1.25,
      "autoResize": true
    },
