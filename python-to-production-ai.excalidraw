    {
      "id": "57082c370e7133b3",
      "type": "text",
      "x": 3600,
      "y": 4315,
      "width": 358.40000000000003,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "4078ad8b62dcd617",
      "index": "a0444",
